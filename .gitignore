.superpowers/
.DS_Store

# raw source media dropped at the repo root never enters the repo —
# compressed web copies live in media/
/*.mov
/*.MOV
/*.mp4
/*.jpg
/*.JPG
/*.jpeg
/*.png
/*.PNG
/*.heic
/*.webp

# the favicons are the only root images that ship
!/favicon-16.png
!/favicon-32.png
!/favicon-96.png
!/favicon-192.png
!/favicon.ico
!/apple-touch-icon.png
